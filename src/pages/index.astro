---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TitreSection from '../components/TitreSection.astro';
import CarteRealisation from '../components/CarteRealisation.astro';
import { identite, presentation, engagements, competences } from '../data/profil';

const toutes = await getCollection('realisations');
const phares = toutes
  .filter((r) => r.data.phare)
  .sort((a, b) => b.data.debut.localeCompare(a.data.debut));

const enProduction = toutes.filter((r) => r.data.statut === 'production').length;
---

<Base
  titre={`${identite.nom} — ${identite.titre}`}
  description="Développeur mobile et web à Yamoussoukro. Applications Flutter, Next.js et Angular en production : facturation conforme DGI, marketplace éducative, portail hôtelier, agent conversationnel WhatsApp."
>
  <!-- ================= Ouverture ================= -->
  <section class="page ouverture">
    <p class="label ouverture__lieu">{identite.ville}</p>

    <h1 class="ouverture__titre">
      Je transforme des besoins concrets en logiciels sur mesure, <em>fiables</em> en production.
    </h1>

    <div class="ouverture__corps">
      <p class="ouverture__lede">
        {identite.nom}, développeur mobile et web. {identite.accroche}.
      </p>
      <p class="ouverture__texte">{presentation[0]}</p>
    </div>

    <div class="ouverture__actions">
      <a class="bouton bouton--plein" href="/realisations">Voir les réalisations</a>
      <a class="bouton bouton--vide" href="/contact">Me contacter</a>
      <a class="bouton bouton--nu" href={identite.cv} download>Télécharger le CV</a>
    </div>

    <dl class="preuves">
      <div>
        <dt>{toutes.length}</dt>
        <dd>projets livrés depuis 2024</dd>
      </div>
      <div>
        <dt>{enProduction}</dt>
        <dd>encore en service aujourd’hui</dd>
      </div>
      <div>
        <dt>4</dt>
        <dd>plateformes : Android, Windows, web, WhatsApp</dd>
      </div>
    </dl>
  </section>

  <!-- ================= Projets phares ================= -->
  <section class="page bloc">
    <TitreSection
      etiquette="Sélection"
      titre="Trois projets en sélection, huit réalisations au total"
      intro="Un produit réglementaire, une infrastructure auto-hébergée, un agent conversationnel. Les cinq autres réalisations sont disponibles dans l'index complet."
    />

    <div class="liste">
      {phares.map((r, i) => <CarteRealisation realisation={r} vedette={i === 0} />)}
    </div>

    <a class="bloc__suite" href="/realisations">
      Voir les {toutes.length} réalisations →
    </a>
  </section>

  <!-- ================= Engagements ================= -->
  <section class="bande">
    <div class="page bloc">
      <TitreSection
        etiquette="Manière de travailler"
        titre="Ce à quoi je m’engage"
        intro="Quatre principes que je ne négocie pas, parce qu’ils décident de la qualité d’un produit longtemps après la livraison."
      />

      <ol class="engagements">
        {
          engagements.map((e, i) => (
            <li class="engagement">
              <span class="engagement__rang" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>{e.titre}</h3>
                <p>{e.texte}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================= Compétences ================= -->
  <section class="page bloc">
    <TitreSection
      etiquette="Boîte à outils"
      titre="Compétences"
      intro="Rien ici qui ne soit utilisé dans au moins un projet livré."
    />

    <div class="competences">
      {
        competences.map((g) => (
          <div class="competence">
            <h3>{g.groupe}</h3>
            <ul>
              {g.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* ---------------- Ouverture ---------------- */

  .ouverture {
    padding-block: clamp(3.5rem, 9vw, 6rem) clamp(2rem, 4vw, 3rem);
  }

  .ouverture__lieu {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.75rem;
  }

  .ouverture__lieu::before {
    content: '';
    width: 1.75rem;
    height: 2px;
    background: var(--accent);
  }

  .ouverture__titre {
    font-size: clamp(2.2rem, 7vw, 4.75rem);
    font-weight: 600;
    letter-spacing: -0.032em;
    line-height: 1.03;
    max-width: 16ch;
    /* Sans cette limite, un mot long déborde la fenêtre sur petit écran. */
    overflow-wrap: break-word;
  }

  .ouverture__titre em {
    font-style: italic;
    color: var(--accent-ink);
    font-variation-settings: 'SOFT' 20, 'WONK' 1;
  }

  .ouverture__corps {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    max-width: 62ch;
  }

  .ouverture__lede {
    font-size: clamp(1.08rem, 2vw, 1.25rem);
    color: var(--ink);
    font-weight: 500;
  }

  .ouverture__texte {
    color: var(--ink-2);
  }

  .ouverture__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* Filets horizontaux seulement : une grille en « fausses gouttières »
     laisse une cellule vide colorée dès que le nombre de colonnes change. */
  .preuves {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    column-gap: 2.5rem;
    margin-top: 3.25rem;
    border-top: 1px solid var(--rule);
  }

  .preuves > div {
    padding-block: 1.35rem 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .preuves dt {
    font-family: var(--f-display);
    font-size: 2.6rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }

  .preuves dd {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 22ch;
  }

  /* ---------------- Boutons ---------------- */

  .bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .bouton--plein {
    background: var(--primary);
    color: var(--on-primary);
  }

  .bouton--plein:hover {
    background: var(--primary-hover);
  }

  .bouton--vide {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .bouton--vide:hover {
    border-color: var(--primary);
    background: var(--primary-soft);
  }

  .bouton--nu {
    color: var(--accent-ink);
    padding-inline: 0.5rem;
  }

  .bouton--nu:hover {
    text-decoration: underline;
  }

  /* ---------------- Blocs ---------------- */

  .bloc {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  /* Bande pleine largeur : le fond déborde, le contenu reste dans la grille. */
  .bande {
    background: var(--surface-2);
    border-block: 1px solid var(--rule);
  }

  .liste {
    display: grid;
    gap: 1.25rem;
  }

  .bloc__suite {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.15rem;
  }

  .bloc__suite:hover {
    color: var(--accent-ink);
  }

  /* ---------------- Engagements ---------------- */

  .engagements {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .engagement {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 0.5rem 1rem;
    background: var(--surface);
    padding: 1.6rem clamp(1.25rem, 3vw, 2rem);
  }

  .engagement__rang {
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--accent);
    padding-top: 0.28rem;
  }

  .engagement h3 {
    font-size: 1.18rem;
    margin-bottom: 0.4rem;
  }

  .engagement p {
    color: var(--ink-2);
    font-size: 0.95rem;
    max-width: 62ch;
  }

  @media (min-width: 900px) {
    .engagements {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---------------- Compétences ---------------- */

  .competences {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem 2.5rem;
  }

  .competence h3 {
    font-family: var(--f-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent-ink);
    padding-bottom: 0.6rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .competence ul {
    display: grid;
    gap: 0.4rem;
  }

  .competence li {
    font-size: 0.93rem;
    color: var(--ink-2);
  }
</style>
