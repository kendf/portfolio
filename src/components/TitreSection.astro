---
interface Props {
  etiquette: string;
  titre: string;
  intro?: string;
}

const { etiquette, titre, intro } = Astro.props;
---

<div class="tete">
  <p class="label">{etiquette}</p>
  <h2>{titre}</h2>
  {intro && <p class="tete__intro">{intro}</p>}
</div>

<style>
  .tete {
    display: grid;
    gap: 0.55rem;
    padding-bottom: 1.5rem;
    margin-bottom: 2.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .tete h2 {
    font-size: clamp(1.65rem, 3.6vw, 2.35rem);
  }

  .tete__intro {
    color: var(--ink-2);
    max-width: 58ch;
    font-size: 1.02rem;
  }

  @media (min-width: 960px) {
    .tete {
      grid-template-columns: 11rem 1fr;
      column-gap: 2.5rem;
      align-items: baseline;
    }

    .tete .label {
      grid-row: 1 / span 2;
      padding-top: 0.5rem;
    }
  }
</style>
